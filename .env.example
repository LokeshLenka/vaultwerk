# === VaultWerk environment lanes ===
# Three lanes, one contract. Each lane pins a Clerk instance and a Mongo
# target; `npm run env:check` verifies them and the API refuses to boot the
# production lane on a mismatch.
#
#   lane        env file          Clerk instance        Mongo
#   ---------   ---------------   --------------------   --------------------------
#   local       .env.local        Development (test)    mongodb://127.0.0.1:27017
#   preview     .env.preview      Development (test)    Atlas preview cluster
#   production  .env.production   Production (live)     Atlas production cluster
#
# Clerk key prefixes: Development instance = pk_test_/sk_test_,
# Production instance = pk_live_/sk_live_. Keys come from
# Dashboard → your app → API Keys, per instance.
#
# .env.preview / .env.production / .env.local are gitignored. The server picks
# the file up from APP_ENV, which the npm scripts set:
#   npm run dev:api              # local      + vite dev on :5173
#   npm run dev:api:preview      # preview    + vite --mode preview
#   npm run dev:api:production   # production
#   npm run server:seed:preview -- --email you@example.com
#
# The SPA reads VITE_-prefixed values only, from the matching Vite mode:
#   vite            → .env.local      (proxies /api to 127.0.0.1:4000)
#   vite --mode preview → .env.preview
#   vite build         → .env.production

# --- Shared across lanes (optional) ---
# Base URL of the VaultWerk API, used by the browser only. Leave empty when the
# Vite dev proxy handles /api (local). Required in preview/production, where
# the SPA is on Vercel and the API runs in a container.
# VITE_API_URL=https://api.example.com
# Optional telemetry endpoint (POST { event, data, timestamp }).
# VITE_TELEMETRY_ENDPOINT=https://example.com/api/telemetry

# --- VaultWerk API server ---
# MongoDB connection string (Atlas or self-hosted).
MONGODB_URI=mongodb://127.0.0.1:27017/vaultwerk
# Port the API listens on.
PORT=4000
# SPA origin(s) allowed to call the API. Single origin for local dev,
# comma-separated allow-list in cloud (Vercel + custom domain).
CLIENT_URL=http://localhost:5173
# CLIENT_URLS=https://vaultwerk.vercel.app,https://vaultwerk.example.com
# Required in production: long random strings for signing sessions.
# JWT_ACCESS_SECRET=change-me-to-32-plus-random-bytes
# JWT_REFRESH_SECRET=change-me-to-a-different-32-plus-random-bytes
# Clerk (cloud auth). Get these from the Clerk dashboard.
# CLERK_SECRET_KEY=sk_live_...
# CLERK_PUBLISHABLE_KEY=pk_live_...
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# Demo-data seeding. Enabled by default outside production; in production
# set ALLOW_SEED=true only to allow the gated /api/seed/demo endpoint.
